[Unit]
Description=ISEKAI camera-server (headless, restarts capture on boot)
# Not strictly needed: nothing here reaches the network until a human clicks
# "Open" (CAMERA_AUTOSTART never does), by which time networking is long up.
# Kept anyway as future-proofing against that changing -- cheap to keep,
# expensive to notice missing if it ever stops being true.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CHANGE-FOR-YOUR-MACHINE: the user camera-server should run as. Paths below
# are spelled out in full rather than via %h -- that specifier only reliably
# resolves against User= in a --user (session) unit; in a system unit like
# this one it silently falls back to the *manager's* home (root) regardless
# of User=, confirmed the hard way on this exact systemd (255).
User=ninilouise
# CHANGE-FOR-YOUR-MACHINE (maybe): systemd does not load a service's
# supplementary groups from /etc/group the way a login session does -- User=
# alone gets only the primary group. The camera device (/dev/video0 on this
# hardware) is group `video`, and without this line the service starts,
# opens no camera, and reports nothing wrong until CAMERA_AUTOSTART's capture
# silently never begins. Check `ls -la /dev/video0` on your machine -- the
# group there is what belongs here, which may not be `video`.
SupplementaryGroups=video
# Provides the virtual display run-camera-server.sh runs against, and ties
# its lifecycle to this service's -- there is nothing worth having Xvfb
# running for once camera-server itself is not.
#
# --auto-servernum rather than a fixed number: a display number this service
# owns exclusively, picked around whatever else is already running an X
# server on the machine (confirmed necessary here -- a long-running, manually
# started `Xvfb :99` unrelated to this service was already using that number,
# and a fixed --server-num=99 collided with it and failed to start every
# time). xvfb-run sets DISPLAY for the process it launches either way, which
# is what run-camera-server.sh's own DISPLAY=:99 default is a fallback for
# (only relevant running that script by hand against a manually-started
# Xvfb, not through this unit).
#
# CHANGE-FOR-YOUR-MACHINE: the absolute path to this checkout's
# scripts/run-camera-server.sh. Hardcoded, not `%h`-relative, for the same
# reason as User= above -- and easy to miss precisely because the paragraph
# above explains why User= needed spelling out, which reads as "the paths are
# handled" rather than "there is another one below". Get this wrong and the
# unit fails to start pointing at a path that does not exist on your machine.
ExecStart=/usr/bin/xvfb-run --auto-servernum --server-args="-screen 0 1280x800x24" \
    /home/ninilouise/ISEKAI-link/scripts/run-camera-server.sh
Restart=on-failure
RestartSec=5

# CHANGE-FOR-YOUR-MACHINE: see docs/Build.md's OpenCV build step for where
# this points on your machine. run-camera-server.sh refuses to start without
# it rather than guessing.
Environment=OPENCV_LIB_DIR=/home/ninilouise/opencv-4.12-local/lib

[Install]
WantedBy=multi-user.target
